rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }
    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function isAdmin() {
      return isSignedIn() && userDoc().role == 'admin';
    }
    function isAlpha() {
      return isSignedIn() && userDoc().role == 'alphaAgent';
    }
    function isAgent() {
      return isSignedIn() && userDoc().role == 'agent';
    }
    function isCourseRep() {
      return isSignedIn() && userDoc().role == 'courseRep';
    }
    function isStaff() {
      return isAdmin() || isAlpha() || isAgent();
    }
    function isAdminOrAgent() {
      return isAdmin() || isAgent() || isAlpha();
    }
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Fields a regular user / course rep must NEVER change on their own profile
    function protectedUserFieldsUnchanged() {
      let d = request.resource.data;
      let e = resource.data;
      return d.role == e.role
        && d.get('plan', e.get('plan', 'free')) == e.get('plan', 'free')
        && d.get('subscription', e.get('subscription', '')) == e.get('subscription', '')
        && d.get('status', 'active') == e.get('status', 'active')
        // Allow owner to set a uniqueId only if it was previously null
        && (
          d.get('uniqueId', null) == e.get('uniqueId', null)
          || (e.get('uniqueId', null) == null && d.get('uniqueId', null) is string)
        )
        && d.get('emailVerified', false) == e.get('emailVerified', false)
        && d.get('email', e.email) == e.email
        && d.get('courseRepMeta', null) == e.get('courseRepMeta', null)
        && d.get('assignedBy', null) == e.get('assignedBy', null);
    }

    function validSelfCreate() {
      let d = request.resource.data;
      return d.role == 'user'
        && d.get('plan', 'free') == 'free'
        && d.get('subscription', 'free') in ['free', null]
        && d.get('status', 'active') == 'active'
        && d.get('emailVerified', false) == false
        && d.get('profileComplete', false) == false
        && d.email is string;
    }

    // ── users ────────────────────────────────────────────────
    match /users/{userId} {
      // Own profile, staff, OR same department (Course Rep notify/count)
      allow read: if isOwner(userId)
        || isAdminOrAgent()
        || (isSignedIn()
            && resource.data.keys().hasAny(['department'])
            && resource.data.department is string
            && resource.data.department == userDoc().get('department', '')
            && resource.data.department != '');

      allow create: if (isOwner(userId) && validSelfCreate())
        || (isAdmin() && request.resource.data.role in
            ['user', 'courseRep', 'agent', 'alphaAgent', 'admin']);

      allow update: if isAdmin()
        || (isAlpha()
            && request.resource.data.role in ['user', 'courseRep', 'agent']
            && resource.data.role != 'admin')
        || (isOwner(userId) && protectedUserFieldsUnchanged());

      allow delete: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    // ── Unique ID lookup ─────────────────────────────────────
    match /idLookup/{uniqueId} {
      allow get: if true;
      allow list: if false;
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email is string;
      allow update, delete: if false;
    }

    // ── agents (optional mirror) ─────────────────────────────
    match /agents/{agentId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ── content ──────────────────────────────────────────────
    match /documents/{docId} {
      allow read: if isSignedIn();
      allow create: if isAdminOrAgent()
        || (isCourseRep()
            && request.resource.data.source == 'courseRep'
            && request.resource.data.uploadedBy == request.auth.uid);
      allow update, delete: if isAdminOrAgent()
        || (isSignedIn()
            && resource.data.uploadedBy == request.auth.uid
            && resource.data.source == 'courseRep');
    }
    match /courses/{courseId} {
      allow read: if isSignedIn();
      allow create: if isAdminOrAgent()
        || (isCourseRep()
            && request.resource.data.source == 'courseRep');
      allow update, delete: if isAdminOrAgent();
    }
    match /cbtQuestions/{questionId} {
      allow read: if isSignedIn();
      allow write: if isAdminOrAgent();
    }
    match /questions/{questionId} {
      allow read: if isSignedIn();
      allow write: if isAdminOrAgent();
    }

    // ── enrollments ──────────────────────────────────────────
    match /enrollments/{enrollmentId} {
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin()
        || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    // ── billing ──────────────────────────────────────────────
    match /subscriptions/{subId} {
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow write: if isAdmin();
    }
    match /payments/{paymentId} {
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow write: if false;
    }
    match /paymentOrphans/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /paymentClaims/{claimId} {
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending';
      allow update, delete: if isAdmin();
    }

    // ── activity / settings / announcements ──────────────────
    match /activityLog/{logId} {
      allow read: if isAdmin() || isAlpha();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    match /appSettings/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // usePlatformSettings often uses settings/platform
    match /settings/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /announcements/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isAlpha();
    }

    // ── notifications ────────────────────────────────────────
    match /notifications/{notifId} {
      allow read: if isAdminOrAgent()
        || (isSignedIn() && resource.data.userId == request.auth.uid);

      // Staff + Course Rep can create (lecture updates, request results)
      allow create: if isAdminOrAgent()
        || isCourseRep();

      allow update: if isAdminOrAgent()
        || (isSignedIn()
            && resource.data.userId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['readByUser', 'readAt', 'archived', 'archivedAt', 'deleted', 'deletedAt']));

      allow delete: if isAdmin();
    }

    // ── student personal timetable ───────────────────────────
    match /timetableEvents/{eventId} {
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin()
        || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    // ── Course Rep published classes ─────────────────────────
    match /classEvents/{eventId} {
      allow read: if isSignedIn();

      allow create: if isCourseRep()
        || isAdminOrAgent();

      allow update, delete: if isAdminOrAgent()
        || (isSignedIn() && resource.data.createdBy == request.auth.uid);
    }

    // ── Requests (Course Rep / student → Admin/Alpha) ────────
    match /requests/{reqId} {
      allow read: if isAdminOrAgent()
        || (isSignedIn() && resource.data.requesterUid == request.auth.uid);

      allow create: if isSignedIn()
        && request.resource.data.requesterUid == request.auth.uid
        && request.resource.data.status == 'pending';

      allow update: if isAdmin() || isAlpha();

      allow delete: if isAdmin();
    }

    // audit trail for client-side profile completion attempts
    match /profileCompletionAudit/{id} {
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // ── Course Rep department posts (announcements + comments) ─
    match /coursePosts/{postId} {
      allow read: if isSignedIn();
      allow create: if isCourseRep() || isAdminOrAgent();
      allow update: if isAdminOrAgent()
        || (isSignedIn() && resource.data.createdBy == request.auth.uid)
        || (isSignedIn()
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['comments']));
      allow delete: if isAdminOrAgent()
        || (isSignedIn() && resource.data.createdBy == request.auth.uid);
    }

    // ── Student saved materials (from Department → Materials) ─
    match /materialSaves/{saveId} {
      allow read: if isAdminOrAgent()
        || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin()
        || (isSignedIn() && resource.data.userId == request.auth.uid);
    }
  }
}
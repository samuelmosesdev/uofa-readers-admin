rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isAgent() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'agent';
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (
        request.auth.uid == userId ||
        (isAdmin() && request.resource.data.role == 'agent')
      );
      allow update: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    match /idLookup/{uniqueId} {
      allow get: if true;
      allow list: if false;
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    match /agents/{agentId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /documents/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isAgent();
    }

    match /courses/{courseId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isAgent();
    }

    match /cbtQuestions/{questionId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isAgent();
    }

    match /questions/{questionId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isAgent();
    }

    match /enrollments/{enrollmentId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /subscriptions/{subId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow write: if isAdmin();
    }

    match /activityLog/{logId} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    match /payments/{paymentId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow write: if false; // only Cloud Functions (Admin SDK)
    }

    match /paymentOrphans/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /paymentClaims/{claimId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /appSettings/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /notifications/{notifId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isAgent();
    }
  }
}
